# OpenRouter — one key for the Curator chat and the image identification
OPENROUTER_API_KEY=sk-or-v1-...
# Optional overrides
# OPENROUTER_MODEL=google/gemini-flash-latest
# OPENROUTER_VISION_MODEL=google/gemini-flash-latest
# Stable secret for the anti-abuse session tokens (any long random string). Falls back to a per-process secret.
# SESSION_SECRET=
# Where community data (testimonies, counters) is written. Defaults to ./data
# LITURGY_DATA_DIR=
# ElevenLabs — only needed by scripts/voiceover.mjs (never by the running site)
# ELEVENLABS_API_KEY=
